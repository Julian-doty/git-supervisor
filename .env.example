# Copy this file to .env and fill in your own values.
# Both scripts load .env automatically if python-dotenv is installed;
# otherwise export these as real environment variables in your shell.

# Required for both backends — GitHub search API token.
# Create one at: https://github.com/settings/tokens (fine-grained or classic,
# no special scopes needed for public repo search).
GITHUB_TOKEN=

# Required only for git_supervisor_cloud.py (Claude backend).
# Create one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
